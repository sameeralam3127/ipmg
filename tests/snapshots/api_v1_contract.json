      "properties": {
        "count": "integer",
        "dns_cache_ttl": "integer",
        "ips": "array[string] | null",
        "resolve": "boolean",
        "source": "string",
        "targets": "null | string",
        "threads": "integer",
        "timeout": "integer"
      },
      "required": []
