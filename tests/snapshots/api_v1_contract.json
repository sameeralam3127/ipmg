      "properties": {
        "count": "integer",
        "filename": "null | string",
        "targets": "array[string]"
      },
      "required": [
        "count",
        "filename",
        "targets"
      ]
    },
    "ValidationIssue": {
      "properties": {
        "loc": "array[integer | string]",
        "msg": "string",
        "type": "string"
      },
      "required": [
        "loc",
        "msg",
        "type"
      ]
    },
    "WebSocketEvent": {
      "type": "ResultEvent | ScanFinishedEvent | ScanStartedEvent"
    }
  },
  "securitySchemes": {
    "HTTPBearer": {
      "scheme": "bearer",
      "type": "http"
    }
  }
}
