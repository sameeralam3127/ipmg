      "properties": {
        "scan_id": "integer",
        "total": "integer",
        "type": "const 'scan_started'"
      },
      "required": [
        "scan_id",
        "total"
      ]
    },
    "ScanSummary": {
      "properties": {
        "avg_latency": "null | number",
        "completed": "integer",
        "config": "object",
        "duration_s": "null | number",
        "error": "null | string",
        "finished_at": "null | string",
        "id": "integer",
        "source": "string",
        "started_at": "string",
        "status": "string",
        "status_counts": "object[integer]",
        "total": "integer"
      },
      "required": [
        "avg_latency",
        "completed",
        "config",
        "duration_s",
        "error",
        "finished_at",
        "id",
        "source",
        "started_at",
        "status",
        "status_counts",
        "total"
      ]
    },
    "Stats": {
      "properties": {
        "host_count": "integer",
        "latest_scan": "ScanSummary | null",
        "running_scans": "array[ScanRecord]",
        "scan_count": "integer",
        "trend": "array[TrendPoint]"
      },
      "required": [
        "host_count",
        "latest_scan",
        "running_scans",
        "scan_count",
        "trend"
      ]
    },
    "TrendPoint": {
      "properties": {
        "active": "integer",
        "avg_latency": "null | number",
        "id": "integer",
        "started_at": "string",
        "total": "integer"
      },
      "required": [
        "active",
        "avg_latency",
        "id",
        "started_at",
        "total"
      ]
    },
