        "oper_status",
        "out_octets",
        "speed_mbps"
      ]
    },
    "Stats": {
      "properties": {
        "host_count": "integer",
        "latest_scan": "ScanSummary | null",
        "running_scans": "array[ScanRecord]",
        "scan_count": "integer",
        "trend": "array[TrendPoint]"
      },
      "required": [
        "host_count",
        "latest_scan",
        "running_scans",
        "scan_count",
        "trend"
      ]
    },
    "TrendPoint": {
      "properties": {
        "active": "integer",
        "avg_latency": "null | number",
        "id": "integer",
        "started_at": "string",
        "total": "integer"
      },
      "required": [
        "active",
        "avg_latency",
        "id",
        "started_at",
        "total"
      ]
    },
    "UploadResult": {
      "properties": {
        "count": "integer",
        "filename": "null | string",
        "targets": "array[string]"
      },
      "required": [
        "count",
        "filename",
        "targets"
      ]
    },
    "ValidationIssue": {
      "properties": {
        "loc": "array[integer | string]",
        "msg": "string",
        "type": "string"
      },
      "required": [
        "loc",
        "msg",
        "type"
      ]
    },
    "WakeRequest": {
      "properties": {
        "broadcast": "string",
        "mac": "string",
        "port": "integer"
      },
      "required": [
        "mac"
      ]
    },
    "WakeSent": {
      "properties": {
        "broadcast": "string",
        "mac": "string",
        "port": "integer"
      },
      "required": [
        "broadcast",
        "mac",
        "port"
      ]
    },
    "WebSocketEvent": {
      "type": "ResultEvent | ScanFinishedEvent | ScanStartedEvent"
    }
  },
  "securitySchemes": {
    "HTTPBearer": {
      "scheme": "bearer",
      "type": "http"
    }
  }
}
